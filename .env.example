# APP
PORT=4000
NODE_ENV=DEVELOPMENT
# DEVELOPMENT, PRODUCTION, TEST

# AUTH / JWT
JWT_SECRET=stradmont-solutions-jwt-secret-key-2026
JWT_ACCESS_EXPIRES_SECONDS=86400
JWT_REFRESH_EXPIRES_SECONDS=604800

# CLOUDFLARE TURNSTILE
# Use 1x0000000000000000000000000000000AA for local testing, or your production secret key
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# DATABASE
DB_TYPE=postgres
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=stradmont_solutions
DB_SSL=false

# REDIS (Optional)
REDIS_ENABLED=false
REDIS_URL=redis://localhost:6379

# MAIL
MAIL_HOST=smtp.stradmontsolutions.com
MAIL_PORT=587
MAIL_USER=info@stradmontsolutions.com
MAIL_PASSWORD=
MAIL_FROM=info@stradmontsolutions.com
ADMIN_NOTIFICATION_EMAIL=info@stradmontsolutions.com

# URL
BASE_URL=http://localhost:4000
FRONTEND_BASE_URL=http://localhost:3000

# LOG
LOG_LEVEL=info

# MEDIA
MEDIA_UPLOAD_PATH=public/uploads
MEDIA_TEMP_PATH=public/uploads/temp