# APP
PORT=4000
NODE_ENV=DEVELOPMENT
# DEVELOPMENT, PRODUCTION, TEST

# AUTH / JWT
JWT_SECRET=otherly-marketplace-jwt-secret-key-2026
JWT_ACCESS_EXPIRES_SECONDS=86400
JWT_REFRESH_EXPIRES_SECONDS=604800

# CLOUDFLARE TURNSTILE
# Use 1x0000000000000000000000000000000AA for local testing, or your production secret key
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA

# DATABASE
DB_TYPE=postgres
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=otherly_marketplace
DB_SSL=false
# DB_SYNCHRONIZE=false (defaults to true in DEV, false in PROD)

# REDIS (Optional)
REDIS_ENABLED=false
REDIS_URL=redis://localhost:6379

# MAIL
MAIL_HOST=smtp.otherly.com
MAIL_PORT=587
MAIL_USER=info@otherly.com
MAIL_PASSWORD=
MAIL_FROM=info@otherly.com
ADMIN_NOTIFICATION_EMAIL=admin@otherly.com

# URL
BASE_URL=http://localhost:4000
FRONTEND_BASE_URL=http://localhost:3000

# LOG
LOG_LEVEL=info

# MEDIA (Local fallback)
MEDIA_UPLOAD_PATH=public/uploads
MEDIA_TEMP_PATH=public/uploads/temp

# SUPABASE STORAGE
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_KEY=your-supabase-service-role-or-anon-key
SUPABASE_STORAGE_BUCKET=media