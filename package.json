{
  "name": "stradmont-solutions-backend",
  "version": "1.0.0",
  "description": "Backend REST API for Stradmont Solutions",
  "main": "dist/server.js",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "start": "node dist/server.js",
    "start:dev": "tsoa spec-and-routes && ts-node-dev --transpile-only --respawn src/server.ts",
    "prepare": "husky",
    "build": "tsoa spec-and-routes && tsc",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint --fix .",
    "format": "prettier --write .",
    "seed:admin": "ts-node ./src/seeder/admin.seed.ts add"
  },
  "keywords": [
    "stradmont-solutions",
    "backend",
    "rest-api",
    "tsoa",
    "express",
    "typeorm"
  ],
  "author": "Stradmont Solutions",
  "license": "ISC",
  "dependencies": {
    "@tsoa/runtime": "^6.5.1",
    "@types/fs-extra": "^11.0.4",
    "bcryptjs": "^2.4.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.0",
    "compression": "^1.7.5",
    "cors": "^2.8.5",
    "express": "^4.21.1",
    "express-rate-limit": "^7.4.1",
    "fs-extra": "^11.2.0",
    "ioredis": "^5.3.2",
    "multer": "1.4.5-lts.1",
    "nodemailer": "^6.9.8",
    "pg": "^8.13.1",
    "reflect-metadata": "^0.2.1",
    "swagger-ui-express": "^5.0.0",
    "tsoa": "^6.5.1",
    "tsyringe": "^4.10.0",
    "typeorm": "^0.3.20",
    "winston": "^3.11.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.14.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/compression": "^1.7.5",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/multer": "^1.4.11",
    "@types/node": "^22.8.7",
    "@types/nodemailer": "^6.4.14",
    "@types/pg": "^8.10.9",
    "@types/swagger-ui-express": "^4.1.7",
    "dotenv": "^16.3.1",
    "eslint": "^9.14.0",
    "eslint-plugin-prettier": "^5.2.1",
    "husky": "^9.1.6",
    "lint-staged": "^15.2.10",
    "prettier": "^3.3.3",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.12.2"
  },
  "lint-staged": {
    "**/*.{js,jsx,ts,tsx}": [
      "prettier --write",
      "eslint --fix"
    ]
  },
  "pnpm": {
    "ignoredBuiltDependencies": [
      "@scarf/scarf"
    ]
  }
}
